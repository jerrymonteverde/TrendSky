{$SITE_DOMAIN:localhost} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        -Server
    }
    @api path /api/v1/*
    handle @api {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy web:3000
    }
}
