# Copy to .env; generate two different values with: openssl rand -hex 32
# An existing .env is never overwritten by setup.
APP_ENV=development
POSTGRES_DB=trendsky
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
API_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=["http://localhost:3000"]
INGESTION_ENABLED=true
JETSTREAM_URL=wss://jetstream.us-east.bsky.network
INGESTION_BATCH_SIZE=250
INGESTION_FLUSH_INTERVAL_MS=1000
INGESTION_QUEUE_MAX_SIZE=5000
INGESTION_RETENTION_DAYS=30
INGESTION_HEARTBEAT_INTERVAL_SECONDS=15
INGESTION_HEARTBEAT_TIMEOUT_SECONDS=60
INGESTION_RECONNECT_BASE_SECONDS=1
INGESTION_RECONNECT_MAX_SECONDS=60
# Statistical worker: independent of ingestion and HTTP request processing.
TRENDS_ENABLED=true
TRENDS_BATCH_SIZE=500
TRENDS_REFRESH_SECONDS=60
TRENDS_BATCH_PAUSE_SECONDS=0.25
TRENDS_MIN_POSTS=5
TRENDS_MIN_CONTRIBUTORS=3
TRENDS_EMERGING_MIN_POSTS=10
TRENDS_EMERGING_MIN_CONTRIBUTORS=5
TRENDS_GROWTH_THRESHOLD=25
TRENDS_EMERGING_LIFT=2
TRENDS_BASELINE_WINDOWS=6
TRENDS_MIN_BASELINE_WINDOWS=3
TRENDS_LATENESS_SECONDS=60
TRENDS_STALE_SECONDS=180
TRENDS_MAX_TOPICS=500
TRENDS_MIN_TOKEN_LENGTH=3
TRENDS_MAX_KEYWORDS_PER_POST=12
# Optional JSON array overrides the conservative built-in phrase lexicon.
# TRENDS_PHRASES=["climate change","cambio climático","artificial intelligence"]
# Local Next.js server -> API; Compose overrides this internally.
API_INTERNAL_URL=http://127.0.0.1:8000
# Production Caddy profile: use a domain you control pointing to the VPS.
SITE_DOMAIN=localhost
# Optional local API URL override; URL-encode credentials.
# DATABASE_URL=postgresql+psycopg://trendsky_app:password@localhost:5432/trendsky
